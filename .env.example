# Public URL of the Convex dev deployment. `npx convex dev` writes it to .env.local.
EXPO_PUBLIC_CONVEX_URL=https://groovy-bobcat-759.convex.cloud
# OAuth 2.0 client ID of the X app. Without it the Twitter row is disabled.
EXPO_PUBLIC_X_CLIENT_ID=

# Dev and review builds only: shows "Continue anonymously (dev)" on the sign-in
# screen. The deployment must also allow it: npx convex env set AUTH_ANONYMOUS_ENABLED true
# EXPO_PUBLIC_DEV_ANONYMOUS_SIGN_IN=true

# Sign-in is configured on the Convex deployment, not here (see convex/README.md,
# "Sign-in"). Google and Apple are commented out until their credentials exist:
#   SITE_URL              web app origin, e.g. http://localhost:8081
#   AUTH_GOOGLE_ID        Google OAuth client ID
#   AUTH_GOOGLE_SECRET    Google OAuth client secret
#   AUTH_APPLE_ID         Apple Services ID identifier
#   AUTH_APPLE_SECRET     Apple client secret JWT (expires after 6 months at most)
#   AUTH_ANONYMOUS_ENABLED=true  dev deployments only
